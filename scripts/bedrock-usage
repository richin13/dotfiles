#!/usr/bin/env bash
set -euo pipefail

PERIOD="${1:-7d}"
DAYS="${PERIOD%d}"
if ! [[ "$DAYS" =~ ^[0-9]+$ ]]; then
  echo "Usage: bedrock-usage [PERIOD]"
  echo "  PERIOD: number of days, e.g. 7d (default), 1d, 30d"
  exit 1
fi

START=$(date -u -d "$DAYS days ago" +%Y-%m-%dT%H:%M:%S)
END=$(date -u +%Y-%m-%dT%H:%M:%S)
TOTAL_SECONDS=$((DAYS * 86400))

declare -A PROFILES
PROFILES=(
  ["opus"]="${ANTHROPIC_DEFAULT_OPUS_MODEL##*/}"
  ["sonnet"]="${ANTHROPIC_DEFAULT_SONNET_MODEL##*/}"
  ["haiku"]="${ANTHROPIC_DEFAULT_HAIKU_MODEL##*/}"
)

# Pricing per 1M tokens (Bedrock on-demand, us-east-1)
declare -A INPUT_COST OUTPUT_COST CACHE_READ_COST CACHE_WRITE_COST
INPUT_COST=( ["opus"]=5.00 ["sonnet"]=3.00 ["haiku"]=1.00 )
OUTPUT_COST=( ["opus"]=25.00 ["sonnet"]=15.00 ["haiku"]=5.00 )
CACHE_READ_COST=( ["opus"]=0.50 ["sonnet"]=0.30 ["haiku"]=0.10 )
CACHE_WRITE_COST=( ["opus"]=6.25 ["sonnet"]=3.75 ["haiku"]=1.25 )

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

fetch_metric() {
  local model="$1" metric="$2" model_id="$3" stat="${4:-Sum}"
  local result
  result=$(aws cloudwatch get-metric-statistics \
    --namespace AWS/Bedrock \
    --metric-name "$metric" \
    --dimensions "Name=ModelId,Value=$model_id" \
    --start-time "$START" \
    --end-time "$END" \
    --period "$TOTAL_SECONDS" \
    --statistics "$stat" \
    --query "Datapoints[0].${stat}" \
    --output text 2>/dev/null)
  echo "$result" > "$TMPDIR/${model}.${metric}"
}

for model in opus sonnet haiku; do
  pid="${PROFILES[$model]}"
  [[ -z "$pid" ]] && continue
  fetch_metric "$model" Invocations "$pid" &
  fetch_metric "$model" InputTokenCount "$pid" &
  fetch_metric "$model" OutputTokenCount "$pid" &
  fetch_metric "$model" CacheReadInputTokenCount "$pid" &
  fetch_metric "$model" CacheWriteInputTokenCount "$pid" &
  fetch_metric "$model" InvocationLatency "$pid" Average &
  fetch_metric "$model" TimeToFirstToken "$pid" Average &
done
wait

read_metric() { cat "$TMPDIR/${1}.${2}" 2>/dev/null || echo "None"; }

format_num() {
  local val="$1"
  if [[ "$val" == "None" || -z "$val" ]]; then echo "0"
  else printf "%'.0f" "$val"
  fi
}

format_ms() {
  local val="$1"
  if [[ "$val" == "None" || -z "$val" ]]; then echo "-"
  else printf "%'.0fms" "$val"
  fi
}

format_cost() {
  local val="$1"
  if [[ "$val" == "0" || "$val" == "0.00" ]]; then echo "\$0.00"
  else printf "\$%.2f" "$val"
  fi
}

calc_cost() {
  local input_tokens="$1" output_tokens="$2" cache_read="$3" cache_write="$4" model="$5"
  [[ "$input_tokens" == "None" ]] && input_tokens=0
  [[ "$output_tokens" == "None" ]] && output_tokens=0
  [[ "$cache_read" == "None" ]] && cache_read=0
  [[ "$cache_write" == "None" ]] && cache_write=0
  awk "BEGIN { printf \"%.2f\", ($input_tokens/1000000)*${INPUT_COST[$model]} + ($output_tokens/1000000)*${OUTPUT_COST[$model]} + ($cache_read/1000000)*${CACHE_READ_COST[$model]} + ($cache_write/1000000)*${CACHE_WRITE_COST[$model]} }"
}

echo ""
echo "  Bedrock Usage Dashboard (last ${DAYS}d)"
echo "  $(printf '%.0s-' {1..50})"
echo ""

TOTAL_COST="0"

for model in opus sonnet haiku; do
  [[ -z "${PROFILES[$model]}" ]] && continue

  input_tokens=$(read_metric "$model" InputTokenCount)
  output_tokens=$(read_metric "$model" OutputTokenCount)
  cache_read=$(read_metric "$model" CacheReadInputTokenCount)
  cache_write=$(read_metric "$model" CacheWriteInputTokenCount)

  cost=$(calc_cost "$input_tokens" "$output_tokens" "$cache_read" "$cache_write" "$model")
  TOTAL_COST=$(awk "BEGIN { printf \"%.2f\", $TOTAL_COST + $cost }")

  echo "  $model"
  echo "    Invocations:    $(format_num "$(read_metric "$model" Invocations)")"
  echo "    Input tokens:   $(format_num "$input_tokens")"
  echo "    Output tokens:  $(format_num "$output_tokens")"
  echo "    Cache read:     $(format_num "$cache_read")"
  echo "    Cache write:    $(format_num "$cache_write")"
  echo "    Avg latency:    $(format_ms "$(read_metric "$model" InvocationLatency)")"
  echo "    Avg TTFT:       $(format_ms "$(read_metric "$model" TimeToFirstToken)")"
  echo "    Est. cost:      $(format_cost "$cost")"
  echo ""
done

echo "  $(printf '%.0s-' {1..50})"
echo "  Total est. cost:  $(format_cost "$TOTAL_COST")"
echo ""
