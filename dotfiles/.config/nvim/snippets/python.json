{
  "Shebang": {
    "prefix": "!#",
    "description": "Add a shebang line",
    "body": ["#!/usr/bin/env python3"]
  },
  "Main Script Entrypoint": {
    "prefix": "ifmain",
    "description": "Add a main script entrypoint",
    "body": [
      "def main():",
      "    \"\"\"Main entrypoint.\"\"\"",
      "    $0",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    main()"
    ]
  },
  "Loud Print": {
    "prefix": "loud",
    "description": "Print a message with a loud comment",
    "body": [
      "print(\"##########################################################################\")",
      "print(\"# $0\")",
      "print(\"##########################################################################\")"
    ]
  },
  "Pytest Skip Test": {
    "prefix": "ptskip",
    "description": "Skip a test in pytest",
    "body": ["import pytest", "@pytest.mark.skip(reason=\"$0\")"]
  },
  "Click CMD App Skeleton": {
    "prefix": "click",
    "description": "Create a skeleton for a Click command-line app",
    "body": [
      "import typing as t",
      "",
      "import click",
      "",
      "",
      "@click.group()",
      "def cli() -> None:",
      "    \"\"\"CLI Entrypoint.\"\"\"",
      "    pass",
      "",
      "",
      "@cli.command()",
      "def ${1:command}() -> t.Any:",
      "    \"\"\"${2:Command help message}\"\"\"",
      "    $0"
    ]
  },
  "Pydantic API Resource Schemas": {
    "prefix": "api:resource",
    "description": "Create Pydantic API resource schemas",
    "body": [
      "class ${1:Resource}Base(BaseModel):",
      "    \"\"\"${2:Resource} base schema.\"\"\"",
      "    pass",
      "",
      "",
      "class ${1:Resource}Create(${1:Resource}Base):",
      "    \"\"\"${2:Resource} create schema.\"\"\"",
      "    pass",
      "",
      "",
      "class ${1:Resource}Patch(BaseModel):",
      "    \"\"\"${2:Resource} patch schema.\"\"\"",
      "    pass",
      "",
      "",
      "class ${3:Resources}Response(${1:Resource}Base):",
      "    \"\"\"${2:Resource} response schema for when multiple records are returned.\"\"\"",
      "    pass",
      "",
      "",
      "class ${1:Resource}Response(${3:Resources}Response):",
      "    \"\"\"${2:Resource} response schema for when individual record returned.\"\"\"",
      "    pass"
    ]
  }
}
