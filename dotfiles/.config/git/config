[user]
	email = richin13@gmail.com
	name = Ricardo Madriz
[core]
  pager = delta
  editor = nvim
[gpg]
	format = ssh
[gpg "ssh"]
	defaultKeyCommand = ssh-add -L

[gitflow "branch"]
  develop = develop
[delta]
  syntax-theme = Dracula

[diff]
  colorMoved = default
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[credential]
	helper = cache
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
