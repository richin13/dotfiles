[include]
	path = ~/.config/git/config.local
[core]
  pager = delta
  editor = nvim
  sshCommand = ssh -o AddKeysToAgent=yes
[gpg]
	format = ssh
[gpg "ssh"]
	defaultKeyCommand = ssh-add -L

[gitflow "branch"]
  develop = develop
[delta]
  syntax-theme = Dracula

[diff]
  colorMoved = default
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[credential]
	helper = cache
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
