font-family = JetBrainsMono Nerd Font
font-size = 13
font-style = Bold
font-feature = -calt, -liga, -dlig
window-decoration = "none"
maximize = true
window-padding-y = 8
background-opacity = 1
theme = dracula
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

