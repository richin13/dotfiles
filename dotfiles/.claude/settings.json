{
  "permissions": {
    "allow": [
      "Read(src/**)",
      "Read(package*.json)",
      "Edit(src/**)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)"
    ],
    "deny": ["Bash(rm:*)", "Bash(curl:*)", "Bash(git push:*)"]
  },
  "includeCoAuthoredBy": false
}
