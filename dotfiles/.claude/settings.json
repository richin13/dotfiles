{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(src/**)",
      "Read(package*.json)",
      "Edit(src/**)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(npm run:*)",
      "Bash(npx *)",
      "Bash(npx gluestack-ui add *)",
      "Bash(ls *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "includeCoAuthoredBy": false
}
